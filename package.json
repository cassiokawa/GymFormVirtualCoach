{
  "name": "gym-form-virtual-coach",
  "version": "0.1.0",
  "description": "CV Fitness & Form Assistant — client-side pose analysis with LLM-backed workout planning",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "build:web": "vite build",
    "scan:exercise-boundary": "node scripts/exercise-data-boundary-scan.mjs",
    "check": "node scripts/exercise-data-boundary-scan.mjs && node scripts/classification-guard.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate:parity": "vitest run src/domain/analysis/parity.test.ts",
    "fetch-models": "node scripts/copy-mediapipe-wasm.mjs && node scripts/fetch-models.mjs",
    "copy-wasm": "node scripts/copy-mediapipe-wasm.mjs",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "server": "node server/server.mjs",
    "dev:all": "node server/server.mjs & vite",
    "test:server": "node --test \"server/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "test:all": "vitest run && node --test \"server/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "spec:validate": "node scripts/formcoach-spec.mjs validate",
    "spec:replay": "node scripts/formcoach-spec.mjs replay",
    "scan:classification": "node scripts/classification-guard.mjs"
  },
  "bin": {
    "formcoach-spec": "scripts/formcoach-spec.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/three": "^0.169.0",
    "fake-indexeddb": "6.0.0",
    "fast-check": "^3.19.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vite": "^8.2.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs": "4.22.0",
    "onnxruntime-web": "1.20.1",
    "three": "^0.169.0"
  }
}
